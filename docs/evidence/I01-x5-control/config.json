{
  "scope": "x5_control_diagnostic",
  "backend": "mujoco",
  "num_envs": 2,
  "steps": 500,
  "output": "runs/I01-x5-reviewed",
  "env": {
    "_target_": "unilab.envs.ManagerBasedRlEnvCfg",
    "scene": {
      "_target_": "unilab.base.scene.SceneCfg",
      "model_file": "assets/generated/I01-x5-control/scene.xml",
      "entities": {
        "objects": {
          "_target_": "unilab.base.entity.EntityCfg",
          "root_body_name": "tube0",
          "body_names": [
            "tube0",
            "tube1",
            "tube2",
            "slot"
          ],
          "actuator_names": []
        },
        "robot": {
          "_target_": "unilab.base.entity.EntityCfg",
          "root_body_name": "left_base_link",
          "joint_names": [
            "left_joint1",
            "left_joint2",
            "left_joint3",
            "left_joint4",
            "left_joint5",
            "left_joint6",
            "left_joint7",
            "left_joint8",
            "right_joint1",
            "right_joint2",
            "right_joint3",
            "right_joint4",
            "right_joint5",
            "right_joint6",
            "right_joint7",
            "right_joint8"
          ],
          "actuator_names": [
            "left_joint1_drive",
            "left_joint2_drive",
            "left_joint3_drive",
            "left_joint4_drive",
            "left_joint5_drive",
            "left_joint6_drive",
            "left_joint7_drive",
            "left_joint8_drive",
            "right_joint1_drive",
            "right_joint2_drive",
            "right_joint3_drive",
            "right_joint4_drive",
            "right_joint5_drive",
            "right_joint6_drive",
            "right_joint7_drive",
            "right_joint8_drive"
          ],
          "body_names": [
            "left_base_link",
            "left_link6",
            "right_base_link",
            "right_link6"
          ]
        }
      }
    },
    "sim_dt": 0.004,
    "ctrl_dt": 0.004,
    "max_episode_seconds": 4.0,
    "seed": 0,
    "auto_reset": false,
    "defer_finite_validation": false,
    "observations": {
      "policy": {
        "_target_": "unilab.managers.ObservationGroupCfg",
        "terms": {
          "object_pose": {
            "_target_": "unilab.managers.ObservationTermCfg",
            "func": {
              "_target_": "hydra.utils.get_class",
              "path": "integrations.unilab.object_scene_terms.ObjectPose"
            },
            "params": {
              "entity_name": "objects",
              "body_names": [
                "tube0",
                "tube1",
                "tube2",
                "slot"
              ]
            }
          },
          "source_geometry": {
            "_target_": "unilab.managers.ObservationTermCfg",
            "func": {
              "_target_": "hydra.utils.get_class",
              "path": "integrations.unilab.object_scene_terms.SourceGeometry"
            },
            "params": {
              "entity_name": "objects",
              "body_names": [
                "tube0",
                "tube1",
                "tube2",
                "slot"
              ]
            }
          },
          "joint_position": {
            "_target_": "unilab.managers.ObservationTermCfg",
            "func": {
              "_target_": "hydra.utils.get_method",
              "path": "unilab.envs.mdp.joint_pos_rel"
            }
          },
          "joint_velocity": {
            "_target_": "unilab.managers.ObservationTermCfg",
            "func": {
              "_target_": "hydra.utils.get_method",
              "path": "unilab.envs.mdp.joint_vel_rel"
            }
          }
        }
      }
    },
    "events": {
      "restore_scene": {
        "_target_": "unilab.managers.EventTermCfg",
        "func": {
          "_target_": "hydra.utils.get_method",
          "path": "unilab.envs.mdp.reset_scene_to_default"
        },
        "mode": "reset"
      }
    },
    "actions": {
      "joint_position": {
        "_target_": "unilab.envs.mdp.JointPositionActionCfg",
        "entity_name": "robot",
        "actuator_names": [
          ".*"
        ],
        "scale": 1.0,
        "use_default_offset": true
      }
    },
    "rewards": {},
    "terminations": {
      "timeout": {
        "_target_": "unilab.managers.TerminationTermCfg",
        "func": {
          "_target_": "hydra.utils.get_method",
          "path": "unilab.envs.mdp.time_out"
        },
        "time_out": true
      }
    },
    "metrics": {
      "mean_tube_height_m": {
        "_target_": "unilab.managers.MetricsTermCfg",
        "func": {
          "_target_": "hydra.utils.get_class",
          "path": "integrations.unilab.object_scene_terms.MeanHeight"
        },
        "params": {
          "entity_name": "objects",
          "body_names": [
            "tube0",
            "tube1",
            "tube2"
          ]
        },
        "reduce": "last"
      },
      "source_geometry_count": {
        "_target_": "unilab.managers.MetricsTermCfg",
        "func": {
          "_target_": "hydra.utils.get_class",
          "path": "integrations.unilab.object_scene_terms.SourceGeometryCount"
        },
        "params": {
          "entity_name": "objects",
          "body_names": [
            "tube0",
            "tube1",
            "tube2",
            "slot"
          ]
        },
        "reduce": "last"
      }
    }
  },
  "video": true
}
